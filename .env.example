# -----------------------------------------------------------------------------
# CHAT DOCKET - EASIEST PAYMENT SETUP (NO TECHNICAL HASSLE)
# -----------------------------------------------------------------------------
# Copy this file to .env.local

# =============================================================================
# OPTION 1: GUMROAD (SUPER EASY - 2 MINUTES SETUP, NO WEBHOOKS REQUIRED)
# =============================================================================
# 1. Sign up on https://gumroad.com
# 2. Products > New Product > Digital Product > Name: Chat Docket Pass > Price: $12 > Publish!
# 3. Paste the generated Gumroad URL below:

NEXT_PUBLIC_PAYMENT_URL_VISA=https://gumroad.com/l/your-visa-product
NEXT_PUBLIC_PAYMENT_URL_AGENCY=https://gumroad.com/l/your-agency-product

# =============================================================================
# OPTION 2: LEMON SQUEEZY (FOR ADVANCED USERS - MERCHANT OF RECORD)
# =============================================================================
NEXT_PUBLIC_LEMON_SQUEEZY_VISA_URL=
NEXT_PUBLIC_LEMON_SQUEEZY_AGENCY_URL=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# =============================================================================
# OPTION 3: STRIPE PAYMENT LINKS OR BUY ME A COFFEE
# =============================================================================
# If you use Stripe Payment Link or BuyMeACoffee, you can paste the link in NEXT_PUBLIC_PAYMENT_URL_VISA.

# Application Metadata
NEXT_PUBLIC_APP_URL=https://chatdocket.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@chatdocket.com
